# Copy to .env and fill in. Never commit .env or paste your key anywhere public.
# Provider: gemini | ollama | groq | openai_compatible
LLM_PROVIDER=gemini
# Gemini: free key from Google AI Studio. Ollama: leave blank.
LLM_API_KEY=
# A current model name from your provider, e.g. a Gemini Flash model listed in AI Studio,
# or an Ollama model you have pulled (ollama list).
LLM_MODEL=
# Only for openai_compatible:
# LLM_BASE_URL=
SEC_USER_AGENT="Your Name your.email@example.com"
# Market data: auto = Bloomberg Terminal if present, then FactSet if configured, then Yahoo Finance
DATA_SOURCE=auto
# Bloomberg Desktop API (only on a PC with a logged-in Terminal)
BLOOMBERG_HOST=localhost
BLOOMBERG_PORT=8194
# FactSet Formula API (developer.factset.com)
FACTSET_USERNAME_SERIAL=
FACTSET_API_KEY=
